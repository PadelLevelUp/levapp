FLASK_ENV=production
POSTGRES_USER=padel_app_user
POSTGRES_DB=padel_app
POSTGRES_PORT=5432
# PAD-292 (B-069): the database is the `postgres` container on the VM's levelup_net
# docker network; the app reaches it by name. It is published on the host's
# loopback only, so the internal IP (10.132.0.2) no longer answers from a container.
POSTGRES_HOST=postgres
MAIL_USERNAME=admin@levapp.app
MAIL_DEFAULT_SENDER=noreply@levapp.app
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
# auth.coach-approval rule 4 (PAD-231): "a coach is waiting" goes to the owner.
ADMIN_NOTIFY_EMAIL=admin@levapp.app
# auth.email-verification rule 7 (PAD-251 / B-043): transactional mail loads its
# images and links from THIS environment's origin, so its assets can be checked
# here and never depend on what prod has deployed.
PUBLIC_WEB_ORIGIN=https://levapp.app

# PAD-471 (auth.coach-crm-sync): HubSpot coach sync. The token is a secret,
# passed by the deploy workflow; without it the sync is off. The two values are
# public HubSpot identifiers. The "Em teste" deal stage ID is to be filled in by
# the owner (HubSpot → Settings → Deals → Pipelines); empty = no deal moves.
HUBSPOT_ACCOUNT_STATUS_PROPERTY=levapp_estado_conta
HUBSPOT_DEAL_STAGE_EM_TESTE=

# admin.foundation (PAD-531): the staff console. ADMIN_HOSTS is the host list the
# /admin/api blueprint answers on (any other Host is a 404). ADMIN_GOOGLE_CLIENT_ID
# is the PUBLIC id of the "LevApp Staff Console web" Google OAuth client
# (in the VM's GCP project; one client for both hosts; tracked, not a secret).
# Its consent screen is External in Testing mode, so the backend's hd/@levapp.app
# checks are the domain wall. Empty = the console shows "sign-in not configured".
ADMIN_HOSTS=admin.levapp.app
ADMIN_GOOGLE_CLIENT_ID=468098103039-hptfeqt5uss7uh1g45ska9vnjcu63vd5.apps.googleusercontent.com
# PAD-532: the console's own origin, for the pending-coach mail and push.
ADMIN_CONSOLE_URL=https://admin.levapp.app
