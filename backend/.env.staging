# Staging environment (staging.levapp.app), deployed from the `staging` branch.
#
# FLASK_ENV=production is deliberate: it selects ProdConfig (prod-like cookie /
# session behaviour) AND satisfies the PAD-95 migration guard, which refuses to
# run `flask db upgrade` against a host in PRODUCTION_POSTGRES_HOSTS (which
# includes `postgres` and 10.132.0.2) unless FLASK_ENV=production.
#
# The prod/staging separation is therefore POSTGRES_DB, not the host. Changing
# POSTGRES_DB below to `padel_app` would point staging at the production
# database — do not.
FLASK_ENV=production
POSTGRES_USER=padel_app_user
POSTGRES_DB=padel_app_staging
POSTGRES_PORT=5432
# PAD-292 (B-069): by container name on levelup_net, like prod (see .env.prod).
POSTGRES_HOST=postgres
# VAPID (web push) and OPENROUTER (paid credit) are intentionally unset — see
# deploy-staging.yaml, which deliberately does not pass them.
#
# GCS is passed, but as staging's OWN bucket rather than production's, so the
# signed-URL path can be exercised without staging being able to write into prod
# uploads. The name is not a credential — access comes from the VM service
# account — and sync-staging-db.sh reads it from here to seed placeholders.
GCS_UPLOADS_BUCKET=padel-levelup-2026-storage-staging

# Mail (PAD-234): staging has a real sender so the email-verification code and
# the coach-approval mail can be tried end to end, but its database is a copy
# of prod's, so MAIL_ALLOWED_RECIPIENTS is what stops it ever mailing a real
# coach: anyone outside the list is dropped and logged
# (padel_app/tools/email_tools.py). Add a test inbox here, never a customer.
# Entries are matched EXACTLY unless they start with '@', so a typo drops mail
# silently and looks identical to 'email is broken'. Both spellings of the
# second tester are listed until we know which mailbox is real; delete the
# other once confirmed.
# MAIL_PASSWORD comes from the deploy workflow (same secret as prod).
MAIL_USERNAME=admin@levapp.app
MAIL_DEFAULT_SENDER=noreply@levapp.app
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
MAIL_ALLOWED_RECIPIENTS=@levapp.app,pedropachecocontas@gmail.com,fernandatrenga@gmail.com,fernandtrenga@gmail.com
ADMIN_NOTIFY_EMAIL=admin@levapp.app
# PAD-624 (PAD-612 D6): no Expo (iOS/Android) push from staging. The staging build
# (EAS "preview") is the same Expo project and bundle id as production, so a phone that
# ever ran the staging app keeps the same push token in the production app; staging
# would push to it. Web push is already off here (no VAPID keys); mail has its allow-list.
EXPO_PUSH_DISABLED=1
# auth.email-verification rule 7 (PAD-251 / B-043): transactional mail loads its
# images and links from THIS environment's origin, so its assets can be checked
# here and never depend on what prod has deployed.
PUBLIC_WEB_ORIGIN=https://staging.levapp.app

# settings.admin-editor (PAD-267): the generic data browser (/editor) is retired
# (owner, 2026-10-07; PAD-532) and deleted (PAD-550): the EDITOR_ENABLED switch no
# longer exists, so nothing here sets it.

# PAD-471 (auth.coach-crm-sync): HubSpot coach sync. The token is a secret,
# passed by the deploy workflow; without it the sync is off. The two values are
# public HubSpot identifiers. The "Em teste" deal stage ID is to be filled in by
# the owner (HubSpot → Settings → Deals → Pipelines); empty = no deal moves.
HUBSPOT_ACCOUNT_STATUS_PROPERTY=levapp_estado_conta
HUBSPOT_DEAL_STAGE_EM_TESTE=

# admin.foundation (PAD-531): the staff console. ADMIN_HOSTS is the host list the
# /admin/api blueprint answers on (any other Host is a 404). ADMIN_GOOGLE_CLIENT_ID
# is the PUBLIC id of the "LevApp Staff Console web" Google OAuth client
# (in the VM's GCP project; one client for both hosts; tracked, not a secret).
# Its consent screen is External in Testing mode, so the backend's hd/@levapp.app
# checks are the domain wall. Empty = the console shows "sign-in not configured".
ADMIN_HOSTS=admin.staging.levapp.app
ADMIN_GOOGLE_CLIENT_ID=468098103039-hptfeqt5uss7uh1g45ska9vnjcu63vd5.apps.googleusercontent.com
# PAD-532: the console's own origin, for the pending-coach mail and push.
ADMIN_CONSOLE_URL=https://admin.staging.levapp.app
# PAD-614: web origins allowed to call the API cross-origin (api. host).
CORS_ALLOWED_ORIGINS=https://staging.levapp.app
# PAD-692 (messaging.sse-realtime rules 20-24): live events go through Postgres LISTEN/NOTIFY.
# Staging runs it first; prod switches by a PR to .env.prod after staging has run it for some days.
# The listener connects straight to POSTGRES_HOST, never through a transaction-mode pooler.
SSE_BROKER=postgres
# PAD-689: staging runs the raised stream cap first, with the threads to carry it (40 left for
# requests). The staging API container is capped at 400 MB (deploy-staging.yaml); the measurement
# that sets prod's numbers is in the ticket. Prod keeps 40/64 until an env PR to .env.prod.
SSE_MAX_STREAMS=120
GUNICORN_THREADS=160
# PAD-693 (auth.login rule 7): the auth rate limiter keeps its hits in Postgres, one budget across
# every API process. Staging first; prod switches by a PR to .env.prod after the soak.
AUTH_RATE_LIMIT_STORE=database
# PAD-695 (delivery.worker-role): the scheduler's jobs run in the padelapp_staging_worker container;
# the API only writes the job store. Requires SSE_BROKER=postgres (job events reach the API's streams).
WORKER_SPLIT=on
# PAD-697 (delivery.events-role): run the events process (ROLE=events, gevent) beside the API.
# Order (R3): this container comes up with EVENTS_SPLIT off; the owner's host apply then routes
# /api/app/events to levapp_events_staging; only then does EVENTS_SPLIT=on make the API answer 410.
# Turning EVENTS_ROLE off requires routing the path back first, or streams get a 502.
EVENTS_ROLE=on
# PAD-704 (delivery.zero-downtime-deploy rule 14): a second API copy, padelapp_staging_b, on the
# upstream's other port, for B8's proof that two copies share events, reminders and the rate budget.
# Prod stays at one copy (no line in .env.prod). Rolled back to 1 on 2026-10-22 after 1 h: each
# deploy with two copies paged out 11-17 MB on the 2 GB host. Back to 2 once the memory budget is settled.
API_COPIES=1
