# Staging environment (staging.levapp.app), deployed from the `staging` branch.
#
# FLASK_ENV=production is deliberate: it selects ProdConfig (prod-like cookie /
# session behaviour) AND satisfies the PAD-95 migration guard, which refuses to
# run `flask db upgrade` against a host in PRODUCTION_POSTGRES_HOSTS (which
# includes `postgres` and 10.132.0.2) unless FLASK_ENV=production.
#
# The prod/staging separation is therefore POSTGRES_DB, not the host. Changing
# POSTGRES_DB below to `padel_app` would point staging at the production
# database — do not.
FLASK_ENV=production
POSTGRES_USER=padel_app_user
POSTGRES_DB=padel_app_staging
POSTGRES_PORT=5432
# PAD-292 (B-069): by container name on levelup_net, like prod (see .env.prod).
POSTGRES_HOST=postgres
# VAPID (web push) and OPENROUTER (paid credit) are intentionally unset — see
# deploy-staging.yaml, which deliberately does not pass them.
#
# GCS is passed, but as staging's OWN bucket rather than production's, so the
# signed-URL path can be exercised without staging being able to write into prod
# uploads. The name is not a credential — access comes from the VM service
# account — and sync-staging-db.sh reads it from here to seed placeholders.
GCS_UPLOADS_BUCKET=padel-levelup-2026-storage-staging

# Mail (PAD-234): staging has a real sender so the email-verification code and
# the coach-approval mail can be tried end to end, but its database is a copy
# of prod's, so MAIL_ALLOWED_RECIPIENTS is what stops it ever mailing a real
# coach: anyone outside the list is dropped and logged
# (padel_app/tools/email_tools.py). Add a test inbox here, never a customer.
# Entries are matched EXACTLY unless they start with '@', so a typo drops mail
# silently and looks identical to 'email is broken'. Both spellings of the
# second tester are listed until we know which mailbox is real; delete the
# other once confirmed.
# MAIL_PASSWORD comes from the deploy workflow (same secret as prod).
MAIL_USERNAME=admin@levapp.app
MAIL_DEFAULT_SENDER=noreply@levapp.app
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
MAIL_ALLOWED_RECIPIENTS=@levapp.app,pedropachecocontas@gmail.com,fernandatrenga@gmail.com,fernandtrenga@gmail.com
ADMIN_NOTIFY_EMAIL=admin@levapp.app
# auth.email-verification rule 7 (PAD-251 / B-043): transactional mail loads its
# images and links from THIS environment's origin, so its assets can be checked
# here and never depend on what prod has deployed.
PUBLIC_WEB_ORIGIN=https://staging.levapp.app

# settings.admin-editor (PAD-267): the LevApp superadmin's data browser (/editor)
# is switched on for staging. ProdConfig defaults it off; production must not set it.
EDITOR_ENABLED=1

# PAD-471 (auth.coach-crm-sync): HubSpot coach sync. The token is a secret,
# passed by the deploy workflow; without it the sync is off. The two values are
# public HubSpot identifiers. The "Em teste" deal stage ID is to be filled in by
# the owner (HubSpot → Settings → Deals → Pipelines); empty = no deal moves.
HUBSPOT_ACCOUNT_STATUS_PROPERTY=levapp_estado_conta
HUBSPOT_DEAL_STAGE_EM_TESTE=

# admin.foundation (PAD-531): the staff console. ADMIN_HOSTS is the host list the
# /admin/api blueprint answers on (any other Host is a 404). ADMIN_GOOGLE_CLIENT_ID
# is the PUBLIC id of the Workspace-internal Google OAuth client; empty = the
# console shows "sign-in not configured" and nothing else changes. The owner
# fills it in here (tracked, not a secret) once the client exists.
ADMIN_HOSTS=admin.staging.levapp.app
ADMIN_GOOGLE_CLIENT_ID=
