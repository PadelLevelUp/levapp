# Staging environment (staging.levapp.app), deployed from the `staging` branch.
#
# FLASK_ENV=production is deliberate: it selects ProdConfig (prod-like cookie /
# session behaviour) AND satisfies the PAD-95 migration guard, which refuses to
# run `flask db upgrade` against a host in PRODUCTION_POSTGRES_HOSTS (which
# includes 10.132.0.2) unless FLASK_ENV=production.
#
# The prod/staging separation is therefore POSTGRES_DB, not the host. Changing
# POSTGRES_DB below to `padel_app` would point staging at the production
# database — do not.
FLASK_ENV=production
POSTGRES_USER=padel_app_user
POSTGRES_DB=padel_app_staging
POSTGRES_PORT=5432
POSTGRES_HOST=10.132.0.2
# Mail (PAD-234): staging has a real sender so the email-verification code and
# the coach-approval mail can be tried end to end, but its database is a copy
# of prod's, so MAIL_ALLOWED_RECIPIENTS is what stops it ever mailing a real
# coach: anyone outside the list is dropped and logged
# (padel_app/tools/email_tools.py). Add a test inbox here, never a customer.
# MAIL_PASSWORD comes from the deploy workflow (same secret as prod).
# VAPID (web push), OPENROUTER (paid credit) and GCS (prod uploads bucket)
# stay unset on purpose — see deploy-staging.yaml.
MAIL_USERNAME=padelapp2025@gmail.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
MAIL_ALLOWED_RECIPIENTS=@levapp.app
ADMIN_NOTIFY_EMAIL=admin@levapp.app
