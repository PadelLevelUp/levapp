FLASK_ENV=development
POSTGRES_USER=padel_app_user
POSTGRES_DB=padel_app
# The shared dev database is NOT exposed to the internet (B-048). Forward it
# first, and leave it running in another terminal:
#
#   gcloud compute ssh levelup-instance --zone europe-west1-b -- -N -L 5434:localhost:5432
#
# Port 5434 marks this as a remote target, so the PAD-95 migration guard still
# refuses `flask db upgrade` here without ALLOW_PRODUCTION_MIGRATIONS=1.
# 5434 is deliberately not 5433 (the local dev database) or 5432 (the local
# multi-tenant server). For a purely local database use .env.local.dev.
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
MAIL_USERNAME=padelapp2025@gmail.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465

# admin.foundation (PAD-531): the staff console. ADMIN_HOSTS is the host list the
# /admin/api blueprint answers on (any other Host is a 404). ADMIN_GOOGLE_CLIENT_ID
# is the PUBLIC id of the Workspace-internal Google OAuth client; empty = the
# console shows "sign-in not configured" and nothing else changes. The owner
# fills it in here (tracked, not a secret) once the client exists.
ADMIN_HOSTS=localhost,127.0.0.1
ADMIN_GOOGLE_CLIENT_ID=
# PAD-532: the console's own origin, for the pending-coach mail and push.
ADMIN_CONSOLE_URL=http://localhost:8090
