FLASK_ENV=development
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=padel_app_user
POSTGRES_DB=padel_app
MAIL_USERNAME=padelapp2025@gmail.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465

# admin.foundation (PAD-531): the staff console. ADMIN_HOSTS is the host list the
# /admin/api blueprint answers on (any other Host is a 404). ADMIN_GOOGLE_CLIENT_ID
# is the PUBLIC id of the Google OAuth client; empty = the console shows "sign-in
# not configured" and nothing else changes. Local runs leave it empty; to sign in
# locally, use the staging/prod id (http://localhost:8090 is an authorised origin).
ADMIN_HOSTS=localhost,127.0.0.1
ADMIN_GOOGLE_CLIENT_ID=
