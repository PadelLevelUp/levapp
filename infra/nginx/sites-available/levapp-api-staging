server {
    # PAD-614 (delivery.api-host rules 1-2): the API on its own host. Same paths as on the web
    # host (/api/...), so a client's base URL is https://api.staging.levapp.app/api. Only the API is served here.
    server_name api.staging.levapp.app;
    # B-182: the SSE token (?token=) is redacted in this log; see conf.d/levapp-log-redaction.conf.
    access_log /var/log/nginx/access.log redacted;
    # PAD-643 (delivery.transport-security): browsers keep to HTTPS for a year.
    add_header Strict-Transport-Security "max-age=31536000" always;

    # SSE endpoint — must come before /api/ block
    location /api/app/events {
        # B-182: an upstream error writes the request line, token included, at level error.
        error_log /var/log/nginx/error.log crit;
        proxy_pass http://levapp_events_staging;  # PAD-697: the events process
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_cache off;
        proxy_set_header Connection '';
        chunked_transfer_encoding on;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        keepalive_timeout 86400s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/app/register/ {
        # B-183: the account lookup carries the activation secret as ?token=; an upstream error
        # would log it.
        error_log /var/log/nginx/error.log crit;
        proxy_pass http://levapp_api_staging;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        proxy_pass http://levapp_api_staging;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Nothing but the API lives on this host.
    location / {
        return 404;
    }

    listen 443 ssl http2;
    ssl_certificate /etc/letsencrypt/live/api.staging.levapp.app/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.staging.levapp.app/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}
