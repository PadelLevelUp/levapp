server {
    # PAD-614: port 80 for api.staging.levapp.app, in its own file so it is valid before the certificate exists
    # (B-383, the same shape as levapp-admin-http). It answers Let's Encrypt's http-01 challenge
    # from the webroot certbot writes to, and sends everything else to https. No server-level
    # `return` or `if`, never `default_server`: levapp.app keeps answering unknown hosts.
    listen 80;
    server_name api.staging.levapp.app;
    access_log /var/log/nginx/access.log redacted;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
