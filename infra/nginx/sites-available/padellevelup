server {
    server_name padellevelup.com www.padellevelup.com;
    # B-182: the SSE token (?token=) is redacted in this log; see conf.d/levapp-log-redaction.conf.
    access_log /var/log/nginx/access.log redacted;

    # SSE endpoint — must come before /api/ block
    location /api/app/events {
        # B-182: an upstream error writes the request line, token included, at level error.
        error_log /var/log/nginx/error.log crit;
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_cache off;
        proxy_set_header Connection '';
        chunked_transfer_encoding on;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        keepalive_timeout 86400s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # PAD-595 step 2: every page of the old domain is a 301 to the same path and query on levapp.app
    # (`$request_uri` keeps both), so QR codes and links already printed or shared keep working.
    # `/api/` and `/.well-known/` below are NOT redirected: store builds of the app call the API on
    # this host, and iOS/Android read the app-site association from it.
    location /register/ {
        # B-183: the activation page carries its secret as ?t=. The redirect keeps it (the new page
        # needs it); no upstream is contacted, so no error line can print it, and the access log is
        # the redacted one. No Referer from this response either.
        add_header Referrer-Policy "no-referrer" always;
        return 301 https://levapp.app$request_uri;
    }

    location /api/app/register/ {
        # B-183: the account lookup carries the activation secret as ?token=; same.
        error_log /var/log/nginx/error.log crit;
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # PAD-595 step 2: the app-site association files (AASA, assetlinks) stay served here, unchanged.
    location /.well-known/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        return 301 https://levapp.app$request_uri;
    }

    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/padellevelup.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/padellevelup.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}
