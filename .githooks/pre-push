#!/usr/bin/env bash
# levapp pre-push hook: runs .githooks/prepush-gate.sh on what is being pushed.
# Install once per clone (all worktrees share it):  git config core.hooksPath .githooks
# Escape hatch: a line `[skip-prepush: <reason>]` in one of the pushed commits' messages.
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel)"
ZERO=0000000000000000000000000000000000000000
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue                       # deleting a remote branch
  case "$remote_ref" in refs/tags/*) continue ;; esac

  # The commits this push adds: from the remote tip, or (new branch) from origin/staging.
  if [ "$remote_sha" != "$ZERO" ] && git cat-file -e "$remote_sha" 2>/dev/null; then
    range="$remote_sha..$local_sha"
  else
    range="$(git merge-base "$local_sha" origin/staging 2>/dev/null || echo "$local_sha~1")..$local_sha"
  fi

  reason="$(git log --format=%B "$range" 2>/dev/null | grep -oE '\[skip-prepush: [^]]+\]' | head -1)"
  if [ -n "$reason" ]; then
    echo "pre-push gate SKIPPED for $remote_ref by a pushed commit: $reason"
    continue
  fi

  if [ "$local_sha" != "$(git rev-parse HEAD)" ]; then
    echo "pre-push gate: pushing $local_ref, which is not the checked-out commit. The gate tests the"
    echo "working tree, so check out $local_ref and push from there (or name a [skip-prepush: …])."
    status=1
    continue
  fi

  PREPUSH_SHA="$local_sha" bash "$ROOT/.githooks/prepush-gate.sh" || status=1
done

exit $status
