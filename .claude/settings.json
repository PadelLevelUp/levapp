{
  "permissions": {
    "allow": [
      "Bash(git push:*)",
      "Bash(gcloud compute ssh levelup-instance --zone europe-west1-b --command \"sudo docker exec -i -e PGOPTIONS='-c default_transaction_read_only=on' postgres psql:*)",
      "Bash(gcloud compute ssh levelup-instance --zone europe-west1-b --command \"sudo docker exec postgres pg_dump -U padel_app_user -Fc padel_app_staging\":*)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(drop table:*)",
      "Bash(DROP TABLE:*)",
      "Read(.env)",
      "Read(./secrets/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cortex hook session-start"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cortex hook pre-write"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "cortex hook pre-read"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cortex hook post-write"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "cortex hook post-read"
          }
        ]
      }
    ]
  }
}
