{
  "expo": {
    "name": "LevApp",
    "slug": "levapp",
    "scheme": "levelup",
    "version": "1.1.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#0d1a30"
    },
    "ios": {
      "supportsTablet": false,
      "associatedDomains": [
        "applinks:levapp.app",
        "applinks:padellevelup.com",
        "applinks:www.padellevelup.com"
      ],
      "bundleIdentifier": "com.padellevelup.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "9K2J8D2ARR",
      "buildNumber": "6",
      "backgroundColor": "#0B1524"
    },
    "android": {
      "package": "com.padellevelup.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "levapp.app",
              "pathPrefix": "/invite/player/"
            },
            {
              "scheme": "https",
              "host": "levapp.app",
              "pathPrefix": "/invite/coach/"
            },
            {
              "scheme": "https",
              "host": "levapp.app",
              "pathPrefix": "/register/"
            },
            {
              "scheme": "https",
              "host": "padellevelup.com",
              "pathPrefix": "/invite/player/"
            },
            {
              "scheme": "https",
              "host": "padellevelup.com",
              "pathPrefix": "/invite/coach/"
            },
            {
              "scheme": "https",
              "host": "padellevelup.com",
              "pathPrefix": "/register/"
            },
            {
              "scheme": "https",
              "host": "www.padellevelup.com",
              "pathPrefix": "/invite/player/"
            },
            {
              "scheme": "https",
              "host": "www.padellevelup.com",
              "pathPrefix": "/invite/coach/"
            },
            {
              "scheme": "https",
              "host": "www.padellevelup.com",
              "pathPrefix": "/register/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1355DC",
          "defaultChannel": "default"
        }
      ],
      "./plugins/with-ci-cleartext"
    ],
    "experiments": {
      "tsconfigPaths": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dc8bbf5f-3e08-4c97-a912-00bb9b1b43e0"
      }
    },
    "owner": "levapps-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/dc8bbf5f-3e08-4c97-a912-00bb9b1b43e0"
    }
  }
}
