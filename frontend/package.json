{
  "name": "levelup",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @levelup/web",
    "build": "npm run build -w @levelup/web",
    "build:dev": "npm run build:dev -w @levelup/web",
    "lint": "npm run lint -w @levelup/web",
    "preview": "npm run preview -w @levelup/web",
    "test": "npm run test -w @levelup/web",
    "test:watch": "npm run test:watch -w @levelup/web",
    "test:e2e": "npm run test:e2e -w @levelup/web",
    "test:e2e:headless": "npm run test:e2e:headless -w @levelup/web",
    "test:e2e:reset": "npm run test:e2e:reset -w @levelup/web",
    "test:e2e:ui": "npm run test:e2e:ui -w @levelup/web"
  }
}
